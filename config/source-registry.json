  "version": "2026-09-02-source-registry-v1",
  "purpose": "Canonical registry for discovery, verification and primary-source collection in BLUELAB Morning Intelligence.",
  "tier_definition": {
    "0": "raw official data, filing or structured research index",
    "1": "primary official source, regulator, journal, society, company newsroom",
    "2": "high-trust wire or general news organization",
    "3": "specialist editorial or trade publication",
    "4": "discovery signal only unless the source itself is the subject"
  },
  "selection_rules": {
    "final_factual_story_min_tier": 3,
    "tier4_requires_upstream_verification": true,
    "prefer_exact_article_or_release_url": true,
    "prefer_api_or_feed_for_discovery_when_available": true,
    "candidate_pool_target_per_chapter": [30, 50]
  },
