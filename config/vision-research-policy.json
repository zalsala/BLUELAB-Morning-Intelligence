  ],
  "source_groups": {
    "binocular_vision_strabismus": ["jaapos.org","tandfonline.com","journals.lww.com","onlinelibrary.wiley.com","sciencedirect.com","iovs.arvojournals.org","tvst.arvojournals.org","journalofoptometry.org"],
    "optometry_visual_science": ["journals.lww.com","onlinelibrary.wiley.com","journalofoptometry.org","iovs.arvojournals.org","tvst.arvojournals.org","arvo.org"],
