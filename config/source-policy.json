{
  "version": "2026-09-02-source-diversity-v1",
  "principles": {
    "discovery_then_verify": true,
    "primary_sources_preferred": true,
    "exact_article_url_required_for_final_selection": true,
    "homepage_or_section_url_not_counted_as_verified_article": true,
    "social_and_aggregators_are_discovery_only_unless_they_are_the_primary_subject": true
