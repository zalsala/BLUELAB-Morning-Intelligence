  "diversity_rules": {
    "general_chapter_min_unique_domains": 5,
    "specialist_chapter_min_unique_domains": 4,
    "max_single_domain_share": 0.4,
    "max_wire_share_reuters_ap_afp_combined": 0.5,
    "target_primary_source_share_min": 0.3,
    "target_specialist_source_share_min": 0.2
  },
